# GitHub OAuth App (callback: <host>/auth/callback). Without it sign-in is off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:3002/auth/callback

# Signs sessions, MCP OAuth tokens and client ids. Use a long random string.
JWT_SECRET=

# Who may sign in: members of these organisations and/or these logins ("*" = anyone).
ALLOWED_GITHUB_ORGS=
ALLOWED_GITHUB_LOGINS=

# Storage: s3, sqlite, filesystem, or empty for in-memory.
STORAGE_TYPE=sqlite
DATA_SOURCE_NAME=excalidraw.db

# For STORAGE_TYPE=s3 (Cloudflare R2 shown).
# S3_BUCKET_NAME=excalidraw
# AWS_REGION=auto
# AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
